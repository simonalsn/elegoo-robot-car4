+def test_protocol_requires_handshake_and_sends_signed_wheels_and_exact_pan(car_mocks):
+    sock=car_mocks['socket']
+    sock.recv.side_effect=[b'{drive_v1}',b'{d1_ok}',b'{d2_ok}']
