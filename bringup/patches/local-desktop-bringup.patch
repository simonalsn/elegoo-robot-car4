+    e=engine(pad({pg.CONTROLLER_AXIS_LEFTY:-19661,pg.CONTROLLER_AXIS_TRIGGERRIGHT:32767}))
+    e._GameEngine__handle_controller_player_actions()
+    e._GameEngine__car.forward.assert_called_once_with(speed=125,lazy=True)
